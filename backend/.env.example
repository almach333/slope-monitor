# Copy this file to `.env` (same folder) and change the values.

# Long random string used to sign login tokens. Generate one with:
#   py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave commented out to use the SQLite file backend/slope_monitor.db.
# For PostgreSQL later, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost/slope_monitor
# DATABASE_URL=

# Frontend origin(s) allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Login session length in minutes. Tip: use 480 during a long demo so you
# are not logged out halfway through.
ACCESS_TOKEN_EXPIRE_MINUTES=60
